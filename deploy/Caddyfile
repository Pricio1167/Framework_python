{$PHARMAGEST_DOMAIN} {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle_path /media/* {
        root * /srv/media
        file_server
    }
    handle {
        reverse_proxy app:8000
    }
    log
}
